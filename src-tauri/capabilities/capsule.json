{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capsule",
  "description": "Capability for the floating subtitle NSPanel window",
  "windows": ["subtitle"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:event:default"
  ]
}
